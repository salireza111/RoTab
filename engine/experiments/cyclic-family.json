{
  "protocol": "simple_cycpep_predict",
  "outputDirectory": ".local/cyclic-family-wasm",
  "files": [
    {
      "name": "sequence.txt",
      "path": ".vendor/rosetta/source/test/protocols/cyclic_peptide_predict/seq.txt"
    }
  ],
  "arguments": [
    "-constant_seed",
    "-jran",
    "1111111",
    "-mute",
    "all",
    "-nstruct",
    "1",
    "-cyclic_peptide:sequence_file",
    "sequence.txt",
    "-symmetric_gly_tables",
    "true",
    "-score:weights",
    "ref2015",
    "-cyclic_peptide:genkic_closure_attempts",
    "1000",
    "-cyclic_peptide:genkic_min_solution_count",
    "1",
    "-cyclic_peptide:min_genkic_hbonds",
    "0",
    "-cyclic_peptide:min_final_hbonds",
    "0",
    "-cyclic_peptide:fast_relax_rounds",
    "1",
    "-cyclic_peptide:rama_cutoff",
    "3.0",
    "-in:file:no_binary_dunlib",
    "true",
    "-out:file:dont_rewrite_dunbrack_database",
    "true",
    "-out:file:silent",
    "result.silent"
  ],
  "modulePrefix": "rosetta-cyclic"
}
